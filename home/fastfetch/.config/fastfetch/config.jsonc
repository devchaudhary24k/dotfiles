// fastfetch, shown by fish when a terminal opens (fish_greeting in config.fish).
//
// The logo is the company mark, drawn from its SVG by
// assets/fastfetch/logo-anim.py into logo.txt (this still version) and
// logo.loop (the idle animation ~/.local/bin/ff-logo plays over it after
// fastfetch has printed; fish starts it, conf.d/95-ff-logo.fish).
// $1..$6 in logo.txt shade it from grey at the tail to white at the tip.
// Everything else is Catppuccin Mocha, matching Ghostty.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#6c7086",
      "2": "#7f849c",
      "3": "#9399b2",
      "4": "#bac2de",
      "5": "#dfe3f2",
      "6": "#f2f2f2"
    },
    // ff-logo draws the animation where the logo is: keep it on the left,
    // and keep this padding in step with PAD_TOP / PAD_LEFT in ff-logo.
    "position": "left",
    "padding": { "top": 5, "left": 2, "right": 5 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "title": "#cba6f7",
      "separator": "#7f849c",
      "output": "#cdd6f4"
    },
    // Nerd Font icon before each key, from fastfetch's own icon set.
    "key": { "type": "both", "width": 12 },
    // Usage as a bar plus the number.
    "percent": { "type": 3 },
    "bar": { "width": 10 },
    "size": { "binaryPrefix": "iec", "ndigits": 1 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─", "outputColor": "#45475a" },

    // System
    { "type": "os",       "key": "OS",       "keyColor": "#89b4fa" },
    { "type": "kernel",   "key": "Kernel",   "keyColor": "#89b4fa" },
    { "type": "uptime",   "key": "Uptime",   "keyColor": "#89b4fa" },
    { "type": "packages", "key": "Packages", "keyColor": "#89b4fa" },
    { "type": "shell",    "key": "Shell",    "keyColor": "#89b4fa" },
    "break",

    // Desktop
    { "type": "de",           "key": "Desktop",  "keyColor": "#cba6f7" },
    { "type": "wm",           "key": "WM",       "keyColor": "#cba6f7" },
    { "type": "terminal",     "key": "Terminal", "keyColor": "#cba6f7" },
    { "type": "terminalfont", "key": "Font",     "keyColor": "#cba6f7" },
    "break",

    // Hardware. The GPU module only reads what the kernel already exposes, so
    // it does not wake the NVIDIA GPU from its power-saving sleep.
    { "type": "host",    "key": "Host",    "keyColor": "#a6e3a1" },
    { "type": "cpu",     "key": "CPU",     "keyColor": "#a6e3a1" },
    { "type": "gpu",     "key": "GPU",     "keyColor": "#a6e3a1", "driverSpecific": false },
    { "type": "memory",  "key": "Memory",  "keyColor": "#a6e3a1" },
    // zram and the swapfile together.
    { "type": "swap",    "key": "Swap",    "keyColor": "#a6e3a1" },
    { "type": "disk",    "key": "Disk",    "keyColor": "#a6e3a1", "folders": "/" },
    { "type": "battery", "key": "Battery", "keyColor": "#a6e3a1" },
    "break",

    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
