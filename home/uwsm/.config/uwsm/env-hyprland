# Read by UWSM before Hyprland starts.
#
# On a hybrid AMD + NVIDIA laptop (nukebyte), Hyprland renders on the AMD iGPU
# and hands frames to the NVIDIA GPU for the monitor wired to it. The two
# device names are stable links that a udev rule must create, because the
# kernel numbers the cards card0/card1 in whatever order the drivers load.
# That rule is not set up on this machine yet; until it is, this does nothing.
if [ -e /dev/dri/amd-igpu ] && [ -e /dev/dri/nvidia-dgpu ]; then
  export AQ_DRM_DEVICES=/dev/dri/amd-igpu:/dev/dri/nvidia-dgpu
fi
