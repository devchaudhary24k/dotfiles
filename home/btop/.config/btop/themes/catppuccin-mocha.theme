# btop theme in Catppuccin Mocha, matching Ghostty and fastfetch.
# Selected in btop.conf with: color_theme = "catppuccin-mocha"

# Background (empty = the terminal's own, so Ghostty's transparency shows).
theme[main_bg]=""

# Text
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"
theme[hi_fg]="#89b4fa"
theme[selected_bg]="#45475a"
theme[selected_fg]="#89b4fa"
theme[inactive_fg]="#7f849c"
theme[proc_misc]="#89dceb"

# Box outlines: CPU blue, memory green, network mauve, processes lavender,
# as in the fastfetch sections.
theme[cpu_box]="#89b4fa"
theme[mem_box]="#a6e3a1"
theme[net_box]="#cba6f7"
theme[proc_box]="#b4befe"
theme[div_line]="#6c7086"

# Graphs and meters go from cool to warm as they fill.
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

theme[cpu_start]="#94e2d5"
theme[cpu_mid]="#89b4fa"
theme[cpu_end]="#b4befe"

theme[free_start]="#a6e3a1"
theme[free_mid]="#a6e3a1"
theme[free_end]="#94e2d5"

theme[cached_start]="#74c7ec"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#b4befe"

theme[available_start]="#f9e2af"
theme[available_mid]="#fab387"
theme[available_end]="#fab387"

theme[used_start]="#fab387"
theme[used_mid]="#eba0ac"
theme[used_end]="#f38ba8"

theme[download_start]="#89b4fa"
theme[download_mid]="#b4befe"
theme[download_end]="#cba6f7"

theme[upload_start]="#f9e2af"
theme[upload_mid]="#fab387"
theme[upload_end]="#f38ba8"
